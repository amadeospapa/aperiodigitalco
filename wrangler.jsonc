{
  // Worker that serves aperiodigitalco.com. Cloudflare builds this from GitHub
  // on every push to main, so a merge is a deploy.
  "name": "aperiodigitalco",
  "main": "src/index.js",
  "compatibility_date": "2026-08-31",

  // The static site. Only what lives in public/ is reachable from the web, which
  // keeps source and docs out of public view.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  // Keeps `wrangler tail` and the dashboard logs useful.
  "observability": { "enabled": true }

  // Secrets are NOT listed here. Set them once with:
  //   npx wrangler secret put RESEND_API_KEY
  //   npx wrangler secret put TELEGRAM_TOKEN
  //   npx wrangler secret put TELEGRAM_CHAT_ID
}
